{
  "name": "crimson-castle",
  "version": "1.0.6",
  "description": "Crimson Castle - a fortress warfare game",
  "main": "electron-main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis && electron-builder --win portable --config.directories.output=dist/portable && powershell -NoProfile -ExecutionPolicy Bypass -File .\\make-portable-zip.ps1",
    "dist:portable": "electron-builder --win portable --publish never --config.directories.output=dist/portable && powershell -NoProfile -ExecutionPolicy Bypass -File .\\make-portable-zip.ps1",
    "release:win": "electron-builder --win nsis --x64 --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "electron": "^39.8.10",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.overengineeredgames.crimsoncastle",
    "productName": "Crimson Castle",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron-main.js",
      "preload.js",
      "index.html",
      "styles.css",
      "js/**/*"
    ],
    "artifactName": "Crimson-Castle-Setup-${version}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "overengineeredgames-ctrl",
        "repo": "Crimson-Castle-",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Crimson Castle",
      "installerIcon": "CrimsonCastle.ico",
      "uninstallerIcon": "CrimsonCastle.ico"
    }
  }
}
